# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Quarto (site/_freeze/ is generated on render; notebooks are committed without outputs)
.quarto/
site/_freeze/
_site/
site/.quarto/
site/_site/

# Per-run outputs from the rollout ladder (runs/<date>_<level>/)
runs/
logs/
manifests/moves/*.parquet

# Quarto leftovers next to notebooks when a render fails mid-execution
site/notebooks/*_files/

# Generated by summarize_catalog.py and write_site_config.py; CI builds it from
# tests/fixtures, HPC from the live catalogs. holdings.json comes from an
# occasional inventory scan (summarize_other.py), not the nightly build, so it
# is committed.
site/data/*
!site/data/holdings.json
