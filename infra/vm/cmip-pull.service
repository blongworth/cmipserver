# Pull the newest site release from VAST (infra/vm/pull_site.sh).
# Installed to /etc/systemd/system by infra/vm/setup.sh. Logs: journalctl -u cmip-pull
[Unit]
Description=Install the newest cmip.whoi.edu site release from VAST
After=network-online.target remote-fs.target
Wants=network-online.target
# Mail on failure once a relay exists (docs/deploy-plan.md §7, request 6), e.g. a template unit that
# runs: systemctl status %i | mail -s "cmip-pull failed" <address>
#OnFailure=cmip-notify@%n.service

[Service]
Type=oneshot
User=cmipsite
Group=www-data
UMask=0022
ExecStart=/usr/local/lib/cmip-site/pull_site.sh
TimeoutStartSec=30min
# least privilege: writes only under /srv/cmip
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/cmip
